# Copia este archivo como .env.local y rellena los valores.
# NUNCA uses el prefijo NEXT_PUBLIC_ para SUPABASE_URL ni para la clave secreta:
# se enviarían al navegador. Solo la clave publicable (abajo) lleva ese prefijo.

# URL del proyecto (Project Settings → API).
SUPABASE_URL=

# Clave secreta (sb_secret_...) de Project Settings → API Keys.
# Solo se usa en el servidor (route handlers de app/api/supabase).
SUPABASE_SECRET_KEY=

# Alternativa para proyectos con claves heredadas (JWT service_role).
# Se usa solo si SUPABASE_SECRET_KEY está vacía.
# SUPABASE_SERVICE_ROLE_KEY=

# Clave publicable (sb_publishable_...) de Project Settings → API Keys.
# Está pensada para el navegador y NO es secreta. La carga no la usa: con RLS
# activado y sin políticas, esta clave no puede leer ni escribir la tabla.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave de MapTiler (cloud.maptiler.com → Account → API keys) para el mapa
# interactivo. Es pública por diseño: restríngela por dominio en MapTiler Cloud
# (localhost y tu dominio de Vercel). Sin ella se muestra un mapa esquemático.
NEXT_PUBLIC_MAPTILER_KEY=

# La app no tiene autenticación: en producción (next start / despliegue) las
# escrituras están bloqueadas. Actívalas solo tras proteger los endpoints.
# ETL_PERMITIR_ESCRITURA=true
